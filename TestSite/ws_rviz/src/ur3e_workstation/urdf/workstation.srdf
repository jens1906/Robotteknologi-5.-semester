<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur3e_workstation">
    <!-- Virtual joint to connect the robot to the world -->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

    <!-- Define the planning group using the UR manipulator group -->
    <group name="ur_manipulator">
        <chain base_link="base_link" tip_link="tool0"/>
    </group>
    
    <!-- Define end effector -->
    <end_effector name="tool0" parent_link="tool0" group="ur_manipulator"/>
    
    <!-- Disable collisions between end effector tool parts (camera holder and camera) -->
    <disable_collisions link1="tool0" link2="realsense_holder" reason="Adjacent"/>
    <disable_collisions link1="tool0" link2="rsd435" reason="Adjacent"/>
    <disable_collisions link1="realsense_holder" link2="rsd435" reason="Adjacent"/>
    <disable_collisions link1="wrist_3_link" link2="realsense_holder" reason="Adjacent"/>
    <disable_collisions link1="wrist_3_link" link2="rsd435" reason="Adjacent"/>
    <disable_collisions link1="wrist_2_link" link2="realsense_holder" reason="Adjacent"/>
    <disable_collisions link1="wrist_2_link" link2="rsd435" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="realsense_holder" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="rsd435" reason="Adjacent"/>
    <!-- REMOVED: forearm and upper_arm collision disables with camera to enable self-collision detection -->
    <!-- The camera can collide with forearm/upper_arm if robot is in bad configuration -->
    
    <!-- Standard UR robot adjacent link collision pairs -->
    <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
    <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_3_link" link2="tool0" reason="Adjacent"/>
    
    <!-- Define home pose -->
    <group_state name="home" group="ur_manipulator">
        <joint name="shoulder_pan_joint" value="0"/>
        <joint name="shoulder_lift_joint" value="-1.57"/>
        <joint name="elbow_joint" value="1.57"/>
        <joint name="wrist_1_joint" value="-1.57"/>
        <joint name="wrist_2_joint" value="-1.57"/>
        <joint name="wrist_3_joint" value="0"/>
    </group_state>
</robot>
